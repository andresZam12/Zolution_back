# =============================================================================
# Zolution Backend — .gitignore
# Covers: Python, Virtualenv, Alembic, Cache, Secrets, IDEs
# =============================================================================

# Environments & secrets
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Alembic
alembic/versions/__pycache__/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak
*.tmp
*.log
