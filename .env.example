# =============================================================================
# Zolution Backend — Environment Variables
# Copy to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
# development | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change_me_to_a_random_256_bit_key

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zolution
DATABASE_USER=zolution
DATABASE_PASSWORD=change_me_in_production
# Full async DSN — assembled from the above in app/core/config.py
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname

# -----------------------------------------------------------------------------
# Auth0
# See: https://manage.auth0.com/ → Applications → your API
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.zolution.app
AUTH0_ALGORITHMS=RS256

# -----------------------------------------------------------------------------
# LLM Providers
# Only fill in the provider(s) you plan to use.
# The active provider is configured per tenant in agent_configs.llm_provider.
# -----------------------------------------------------------------------------
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# See: https://developers.facebook.com/docs/whatsapp/cloud-api
# -----------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change_me_to_a_random_string

# -----------------------------------------------------------------------------
# Google Calendar API
# OAuth2 credentials — downloaded from Google Cloud Console
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback

# -----------------------------------------------------------------------------
# Superadmin
# The superadmin DB connection bypasses RLS — keep these credentials secure.
# -----------------------------------------------------------------------------
SUPERADMIN_DB_USER=zolution_admin
SUPERADMIN_DB_PASSWORD=change_me_superadmin_password
